{
  "name": "obsidian-emoji-autocomplete",
  "version": "1.5.4",
  "description": "This plugin suggests emoji when you type a shortcode :smile:",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build:dev": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs --once",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node ./versionbump.mjs && git add manifest.json versions.json",
    "lint": "tsc -noEmit -skipLibCheck && oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "review": "node scripts/review.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.2.1",
    "esbuild": "^0.23.1",
    "esbuild-plugin-replace": "^1.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^30.1.3",
    "obsidian": "latest",
    "obsidian-test-mocks": "^7.3.0",
    "oxlint": "^1.60.0",
    "tslib": "^2.8.1",
    "typescript": "5.5.4",
    "vitest": "^3.2.7",
    "woff2base64": "^2.0.0"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "gemoji": "^8.1.0"
  }
}
